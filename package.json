{
	"name": "dibk-design",
	"version": "11.3.5",
	"homepage": "https://arkitektum.github.io/dibk-design/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Arkitektum/dibk-design.git"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.es.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.es.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./tokens.css": "./dist/tokens.css",
		"./theme.css": "./dist/theme.css",
		"./dibk-design.css": "./dist/dibk-design.css"
	},
	"type": "module",
	"files": [
		"dist",
		"README.md"
	],
	"dependencies": {
		"react-select": "^5.10.2"
	},
	"scripts": {
		"generate:colors": "node scripts/generate-colors.mjs",
		"build": "pnpm run build:lib && pnpm run build:storybook",
		"build:storybook": "storybook build",
		"build:lib": "tsc -b && vite build",
		"prebuild:lib": "pnpm run generate:colors",
		"prebuild:storybook": "pnpm run generate:colors",
		"prestorybook": "pnpm run generate:colors",
		"postbuild:lib": "node scripts/copy-theme-files.mjs",
		"dev": "vite",
		"lint": "biome lint .",
		"preview": "vite preview",
		"serve-storybook": "serve -l 5000 ./storybook-static",
		"storybook": "storybook dev -p 6006",
		"test": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@eslint/js": "^10.0.1",
		"@microsoft/api-extractor": "^7.58.8",
		"@storybook/addon-a11y": "^10.4.3",
		"@storybook/addon-docs": "^10.4.3",
		"@storybook/addon-links": "^10.4.3",
		"@storybook/addon-onboarding": "^10.4.3",
		"@storybook/addon-vitest": "^10.4.3",
		"@storybook/builder-vite": "^10.4.3",
		"@storybook/react-vite": "^10.4.3",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/parser": "^8.61.0",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.4.1",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router-dom": "^7.17.0",
		"sass": "^1.100.0",
		"serve": "^14.2.6",
		"storybook": "^10.4.3",
		"typescript": "6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-dts": "^5.0.2",
		"vite-plugin-svgr": "^5.2.0",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"react-router-dom": "^6.4.0 || ^7.0.0"
	},
	"packageManager": "pnpm@10.28.1"
}
