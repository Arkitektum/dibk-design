{
	"name": "dibk-design",
	"version": "11.5.0",
	"homepage": "https://arkitektum.github.io/dibk-design/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Arkitektum/dibk-design.git"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.es.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.es.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./tokens.css": "./dist/tokens.css",
		"./theme.css": "./dist/theme.css",
		"./fonts.css": "./dist/fonts.css",
		"./dibk-design.css": "./dist/dibk-design.css"
	},
	"type": "module",
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"dependencies": {
		"react-select": "^5.10.2"
	},
	"scripts": {
		"generate:colors": "node scripts/generate-colors.mjs",
		"build": "pnpm run build:lib && pnpm run build:storybook",
		"build:storybook": "storybook build",
		"build:lib": "tsc -b && vite build",
		"prebuild:lib": "pnpm run generate:colors",
		"prebuild:storybook": "pnpm run generate:colors",
		"prestorybook": "pnpm run generate:colors",
		"postbuild:lib": "node scripts/copy-theme-files.mjs",
		"dev": "vite",
		"lint": "pnpm run lint:biome && pnpm run lint:eslint",
		"lint:biome": "biome lint .",
		"lint:eslint": "eslint .",
		"preview": "vite preview",
		"serve-storybook": "serve -l 5000 ./storybook-static",
		"storybook": "storybook dev -p 6006",
		"test": "pnpm run test:unit && pnpm run test:stories",
		"test:unit": "vitest run",
		"test:stories": "vitest run --config vitest.storybook.config.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@eslint/js": "^10.0.1",
		"@microsoft/api-extractor": "^7.59.0",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-links": "^10.5.10",
		"@storybook/addon-onboarding": "^10.5.10",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/builder-vite": "^10.5.10",
		"@storybook/react-vite": "^10.5.10",
		"@types/node": "^26.3.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@typescript-eslint/parser": "^8.68.0",
		"@vitejs/plugin-react": "^6.1.0",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-plugin-storybook": "10.5.10",
		"globals": "^17.11.0",
		"playwright": "^1.62.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.2",
		"sass": "^1.103.1",
		"serve": "^14.2.6",
		"storybook": "^10.5.10",
		"typescript": "6.0.3",
		"vite": "^8.2.2",
		"vite-plugin-dts": "^5.0.3",
		"vite-plugin-svgr": "^5.2.0",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"react-router-dom": "^6.4.0 || ^7.0.0"
	},
	"packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
